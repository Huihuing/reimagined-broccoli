# Local defaults; for Render set the separate MONITOR Supabase project.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mini_watch
DB_USER=postgres
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_SSLMODE=prefer
SECRET_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET
SESSION_COOKIE_SECURE=false
EVENT_TOKEN=CHANGE_ME_TO_A_SHARED_RANDOM_TOKEN
SENTRY_DSN=
SENTRY_ENVIRONMENT=mini-monitor
APP_VERSION=day2-v1
ENABLE_SENTRY_TEST=false
# Legacy SESSION_SECRET remains supported if SECRET_KEY is unset.
